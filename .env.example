# ═══════════════════════════════════════════════════
# Nexus Commerce — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values.
# Never commit `.env` (it's in .gitignore).

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Nexus Commerce"
NEXT_PUBLIC_BUSINESS_TYPE="RETAIL"
NEXT_PUBLIC_STORE_TIER="ENTERPRISE"
NEXT_PUBLIC_CURRENCY="USD"

# ─── Database (Supabase Postgres) ───
# Pooled connection (port 6543) — must include ?pgbouncer=true&connection_limit=1
DATABASE_URL=""
# Direct connection (port 5432) — used by Prisma migrations
DIRECT_URL=""

# ─── Auth (Auth.js v5) ───
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Rate limiting (Upstash — optional until Phase 4) ───
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Email ───
# "console" prints to terminal · "resend" sends real email
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Nexus Commerce <noreply@yourdomain.com>"

# ─── Payments (Phase 3) ───
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Observability (Phase 0.9) ───
NEXT_PUBLIC_SENTRY_DSN=""
